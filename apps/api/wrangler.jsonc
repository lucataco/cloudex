{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudex-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The dashboard's built files (apps/dashboard/build.mjs), bundled into worker.js.
  "alias": { "cloudex-dashboard-assets": "../dashboard/dist/assets.js" },
  "observability": { "enabled": true },
  // One container per Sandbox Durable Object. A newly pushed image can take
  // 15-20 minutes before it starts (spike S7), so deploys must wait for a test boot.
  "containers": [
    {
      "class_name": "Sandbox",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "../../images/base/Dockerfile" } }
    }
  ],
  // NODE: one Node object per node (node.ts), which holds its agent's control
  // socket. Declared through exports, so a deployment from before nodes gets the
  // new class on its next deploy with no migration step. cloudex deploy's
  // workerMetadata (go/internal/deploy) must declare the same; a test there checks.
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "Sandbox" },
      { "name": "NODE", "class_name": "Node" }
    ]
  },
  "exports": {
    "Sandbox": { "type": "durable-object", "storage": "sqlite" },
    "Node": { "type": "durable-object", "storage": "sqlite" }
  },
  // No database_id: wrangler creates the database on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "cloudex" }],
  // Backups of /home. Optional at runtime: cloudex deploy leaves the binding out
  // when the account hasn't turned R2 on, and backups are then skipped.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "cloudex-backups" }],
  // PREVIEW_ZONE: a zone in this account that serves preview links
  // (https://<port>-<id>-<token>.<zone>). Empty turns preview links off.
  // NODE_IMAGE: the sandbox image nodes pull, as its published reference with
  // its digest (ghcr.io/lucataco/cloudex-base:<tag>@sha256:...). cloudex deploy
  // sets it; empty here.
  // NODE_AGENT: the node agent image's tag and the digest it pointed at when
  // cloudex deploy ran (<tag>@sha256:...), which the install command that
  // cloudex node add prints pins with --digest; empty when it wasn't published.
  "vars": { "PREVIEW_ZONE": "", "NODE_IMAGE": "", "NODE_AGENT": "" }
  // Secrets: ADMIN_KEY (wrangler secret put ADMIN_KEY). Locally, put it in .dev.vars.
}

{
  "name": "cloudex-monorepo",
  "private": true,
  "description": "Open-source agent computers in your own Cloudflare account",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @cloudex/api dev",
    "deploy:api": "pnpm --filter @cloudex/api run deploy"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  }
}
